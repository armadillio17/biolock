# Application Settings
APP_URL=http://localhost:5173
DEBUG=True
SECRET_KEY=your-secret-key-here-generate-with-django
ALLOWED_HOSTS=localhost,127.0.0.1,::1,yourdomain.com

# Database Configuration
SUPABASE_DB_URL=postgresql://username:password@host:5432/database

# Email/SMTP Configuration (Gmail Example)
# To use Gmail: https://support.google.com/accounts/answer/185833?hl=en (App Passwords)
# To use other providers: Update EMAIL_HOST, EMAIL_PORT accordingly
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Alternative SMTP Providers:
# - Gmail: smtp.gmail.com:587 (TLS) or :465 (SSL)
# - Outlook/Hotmail: smtp-mail.outlook.com:587
# - SendGrid: smtp.sendgrid.net:587
# - Mailgun: smtp.mailgun.org:587
# - AWS SES: email-smtp.region.amazonaws.com:587

# Local testing only: accept any Host header and any CORS origin, so an
# ngrok tunnel or a phone on the LAN can reach the API without listing each
# URL above. Only takes effect while DEBUG=True. Never enable in production.
DEV_OPEN_NETWORK=False
